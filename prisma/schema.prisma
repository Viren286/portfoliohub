// PortfolioHub database schema (PostgreSQL)
// Better Auth tables (User, Session, Account, Verification, TwoFactor) use the field names
// Better Auth expects; our own content tables hang off User.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PortfolioStatus {
  DRAFT
  PUBLISHING
  LIVE
  FAILED
  UNPUBLISHED
  SUSPENDED
}

enum DeploymentStatus {
  QUEUED
  RENDERING
  UPLOADING
  LIVE
  FAILED
  SUPERSEDED
}

enum TemplateTier {
  FREE
  PRO
}

enum FileKind {
  RESUME
  AVATAR
  PROJECT_IMAGE
  PROJECT_DOC
  CERTIFICATE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
  VOLUNTEER
  OTHER
}

enum ExtraKind {
  PUBLICATION
  EXTRACURRICULAR
  POSITION
  VOLUNTEER
  HOBBY
  TESTIMONIAL
  AWARD
}

enum SubStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

// ---------------------------------------------------------------- Auth (Better Auth)

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  role             String    @default("user") // "user" | "admin" (Better Auth admin plugin)
  banned           Boolean   @default(false) // suspended accounts
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  profile        Profile?
  education      Education[]
  skills         Skill[]
  projects       Project[]
  experiences    Experience[]
  certifications Certification[]
  extras         ExtraItem[]
  files          UploadedFile[]
  portfolios     Portfolio[]
  subscription   Subscription?
  usage          UsageRecord[]

  @@index([createdAt])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String  @id
  secret      String
  backupCodes String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("twoFactor")
}

// ---------------------------------------------------------------- Portfolio content

model Profile {
  userId       String        @id
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  headline     String?
  about        String?
  contactEmail String?
  phone        String?
  location     String?
  linkedinUrl  String?
  githubUrl    String?
  socials      Json          @default("[]") // [{ label, url }]
  avatarFileId String?       @unique
  avatar       UploadedFile? @relation("Avatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  resumeFileId String?       @unique
  resume       UploadedFile? @relation("Resume", fields: [resumeFileId], references: [id], onDelete: SetNull)
  updatedAt    DateTime      @updatedAt
}

model Education {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  String
  degree       String?
  major        String?
  startYear    Int?
  endYear      Int?
  grade        String?
  coursework   String[]
  achievements String[]
  position     Int      @default(0)

  @@index([userId, position])
}

model Skill {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  category String
  position Int    @default(0)

  @@unique([userId, category, name])
  @@index([userId, position])
}

model Project {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  summary       String?
  description   String?
  technologies  String[]
  features      String[]
  contributions String?
  category      String?
  repoUrl       String?
  liveUrl       String?
  thumbFileId   String?
  thumb         UploadedFile?  @relation("ProjectThumb", fields: [thumbFileId], references: [id], onDelete: SetNull)
  media         ProjectMedia[]
  position      Int            @default(0)
  createdAt     DateTime       @default(now())

  @@index([userId, position])
}

model ProjectMedia {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId    String
  file      UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  alt       String?
  position  Int          @default(0)

  @@index([projectId, position])
}

model Experience {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     String
  title            String
  employmentType   EmploymentType?
  startDate        DateTime?
  endDate          DateTime?
  responsibilities String[]
  achievements     String[]
  skills           String[]
  position         Int             @default(0)

  @@index([userId, position])
}

model Certification {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  issuer        String?
  issuedOn      DateTime?
  credentialUrl String?
  fileId        String?
  file          UploadedFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  position      Int           @default(0)

  @@index([userId, position])
}

model ExtraItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ExtraKind
  title       String
  subtitle    String?
  description String?
  url         String?
  date        DateTime?
  position    Int       @default(0)

  @@index([userId, kind, position])
}

model UploadedFile {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       FileKind
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  sha256     String
  width      Int?
  height     Int?
  variants   Json     @default("{}") // { "400": key, "800": key, "1600": key }
  fileName   String?
  createdAt  DateTime @default(now())

  avatarOf       Profile?        @relation("Avatar")
  resumeOf       Profile?        @relation("Resume")
  thumbOf        Project[]       @relation("ProjectThumb")
  projectMedia   ProjectMedia[]
  certifications Certification[]

  @@index([userId, kind])
}

// ---------------------------------------------------------------- Templates & portfolios

model Template {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  category         String
  description      String
  tier             TemplateTier      @default(FREE)
  has3D            Boolean           @default(false)
  isEnabled        Boolean           @default(true)
  currentVersionId String?           @unique
  currentVersion   TemplateVersion?  @relation("Current", fields: [currentVersionId], references: [id])
  versions         TemplateVersion[]
  portfolios       Portfolio[]
  createdAt        DateTime          @default(now())
}

model TemplateVersion {
  id          String                @id @default(cuid())
  templateId  String
  template    Template              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     String
  manifest    Json
  createdAt   DateTime              @default(now())
  currentOf   Template?             @relation("Current")
  portfolios  Portfolio[]
  deployments PortfolioDeployment[]

  @@unique([templateId, version])
}

model Portfolio {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  slug              String                @unique
  customDomain      String?               @unique
  templateId        String
  template          Template              @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersionId String
  templateVersion   TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  customization     Json                  @default("{}")
  sections          Json                  @default("{}")
  status            PortfolioStatus       @default(DRAFT)
  liveDeploymentId  String?               @unique
  liveUrl           String?
  deployments       PortfolioDeployment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model PortfolioDeployment {
  id                String           @id @default(cuid())
  portfolioId       String
  portfolio         Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  templateVersionId String
  templateVersion   TemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  status            DeploymentStatus @default(QUEUED)
  target            String // "local" | "cloudflare"
  snapshot          Json?
  storagePrefix     String?
  url               String?
  fileCount         Int?
  totalBytes        Int?
  errorCode         String?
  errorMessage      String?
  durationMs        Int?
  triggeredById     String
  createdAt         DateTime         @default(now())
  finishedAt        DateTime?

  @@index([portfolioId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------- Plans & usage

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique // FREE, PRO, ADMIN
  name          String
  pricePaise    Int?
  entitlements  Json
  isActive      Boolean        @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  status           SubStatus @default(ACTIVE)
  provider         String? // razorpay | stripe | manual
  providerRef      String?   @unique
  currentPeriodEnd DateTime?
  updatedAt        DateTime  @updatedAt
}

model UsageRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric      String
  periodStart DateTime
  quantity    Int      @default(0)

  @@unique([userId, metric, periodStart])
}

model AdminSetting {
  key         String   @id
  value       Json
  updatedById String
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------- Database-backed hosting
// Used when DEPLOY_TARGET=database / STORAGE_DRIVER=database (serverless hosting with no disk,
// e.g. Vercel + Neon). Same model as the edge: immutable files per deployment + a pointer per site.

model SitePointer {
  slug         String   @id
  portfolioId  String
  deploymentId String
  state        String // "live" | "suspended"
  updatedAt    DateTime @updatedAt
}

model SiteFile {
  deploymentId String
  path         String
  contentType  String
  cacheControl String
  body         Bytes

  @@id([deploymentId, path])
}

model StoredObject {
  key                String   @id
  contentType        String
  cacheControl       String?
  contentDisposition String?
  body               Bytes
  createdAt          DateTime @default(now())
}
